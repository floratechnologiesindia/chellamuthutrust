# Client (Vite)
VITE_API_URL=/api

# Dual portals (local dev: donor.localhost:8080 / app.localhost:8080)
VITE_WEBSITE_URL=https://msctrust.org
VITE_DONOR_PORTAL_URL=http://donor.localhost:8080
VITE_APP_PORTAL_URL=http://app.localhost:8080

# API Server
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/chellamuthu
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:3001/uploads

# Razorpay (server secret + client public key + webhook secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# Email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# WhatsApp (WATI)
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# Development — show OTP in API response and UI (no real WhatsApp needed)
SHOW_DEV_OTP=true
# Manual payment simulation (disabled when Razorpay keys are configured)
MANUAL_PAYMENTS=false

# Client — mirror server dev flags
VITE_SHOW_DEV_OTP=true
VITE_MANUAL_PAYMENTS=false
